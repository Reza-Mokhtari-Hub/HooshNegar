# =============================================================================
# HooshNegar AI (هوش‌نگار) — Production Environment Variables (Phases 1, 2 & 3)
# Copy to .env and populate real secrets. NEVER commit real secrets to Git.
# =============================================================================

# PostgreSQL (Neon serverless connection string for Cloudflare Workers production)
# Leave empty locally to use embedded PostgreSQL (PGlite in ./data/pgdata)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 32-byte encryption master key for AES-256-GCM provider & Telegram secrets
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=""

# Server-side session signing secret (minimum 32 random characters)
# Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Dedicated HMAC-SHA256 signing secret for Telegram Stars invoice payloads
# Generate with: openssl rand -hex 32 (falls back to ENCRYPTION_MASTER_KEY if unset)
PAYMENT_PAYLOAD_SECRET=""

# Bearer secret for HTTP maintenance endpoint (/api/cron/maintenance)
# (Cloudflare Workers also executes maintenance directly via native hourly Cron Trigger)
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Public Cloudflare Workers URL (or your custom Cloudflare domain)
APP_URL="https://hooshnegar-ai.your-subdomain.workers.dev"

# Optional: Initial Super Admin bootstrap (only applied when admin_users table is empty)
# Password must be >= 12 chars with uppercase, lowercase, and digit.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="مدیر ارشد سیستم"

# =============================================================================
# PHASE 2 — Upstash QStash (Durable Background Job Queue & Retries)
# =============================================================================
# Optional regional endpoint if your Upstash account is not on default US (e.g. EU Central):
# https://qstash-eu-central-1.upstash.io
QSTASH_URL=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Optional override for QStash worker callback base URL (defaults to APP_URL)
QSTASH_CALLBACK_BASE_URL=""

# =============================================================================
# PHASE 2 — Cloudflare R2 Object Storage (Persistent Generated Media & Signed URLs)
# =============================================================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# =============================================================================
# DEVELOPMENT / AUTOMATED TESTING ONLY (STRICTLY ignored in production)
# Set AI_MOCK_MODE="true" in local dev/tests to use isolated mock AI providers
# =============================================================================
AI_MOCK_MODE="false"

# Optional fallback Gemini key (providers configured in Admin Dashboard take precedence)
GEMINI_API_KEY=""
