{
  "name": "hooshnegar",
  "main": "worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "alias": {
    "@electric-sql/pglite": "./src/db/pgliteStub.ts",
    "drizzle-orm/pglite": "./src/db/pgliteStub.ts",
    "drizzle-orm/pglite/migrator": "./src/db/pgliteStub.ts",
    "hash-wasm": "./src/server/security/hashWasmStub.ts",
    "iconv-lite": "./src/server/cloudflare/iconvLiteShim.ts"
  }
}
