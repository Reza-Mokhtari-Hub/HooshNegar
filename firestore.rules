rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Reusable hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'rezaxa1@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Pillar 2: Validation Blueprints (Anti-Update-Gap)
    function isValidAdminProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 255 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 160 &&
        data.role in ['super_admin', 'admin', 'operator', 'auditor'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditMirror(data) {
      return data.keys().hasAll(['actorUid', 'action', 'resourceType', 'severity', 'createdAt']) &&
        data.keys().hasOnly(['actorUid', 'action', 'resourceType', 'severity', 'createdAt']) &&
        isValidId(data.actorUid) &&
        data.actorUid == request.auth.uid &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 120 &&
        data.resourceType is string && data.resourceType.size() >= 2 && data.resourceType.size() <= 80 &&
        data.severity in ['info', 'warning', 'critical'] &&
        data.createdAt is timestamp;
    }

    // Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isVerified() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified() &&
        isValidId(adminId) &&
        isValidAdminProfile(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerified() &&
        isValidId(adminId) &&
        isValidAdminProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'updatedAt'])
        );
      allow delete: if isVerified() && isValidId(adminId) && isBootstrappedAdmin();
    }

    // Collection: /auditMirrors/{auditId}
    match /auditMirrors/{auditId} {
      allow get: if isVerified() && isValidId(auditId) && isAdmin();
      allow list: if isVerified() && (resource.data.actorUid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified() &&
        isValidId(auditId) &&
        isValidAuditMirror(incoming()) &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if false;
      allow delete: if false;
    }
  }
}
